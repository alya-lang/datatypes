## Example usage and walkthrough for datatypes
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as pkg

function main()
    say "=== datatypes Package Showcase ==="
    say ""

    # 1. RingBuffer
    say "--- 1. RingBuffer (Circular Buffer) ---"
    let rb = pkg::new_ring_buffer(4)
    rb.push("alpha")
    rb.push("beta")
    rb.push("gamma")
    say f"RingBuffer size: {rb.size()} / {rb.capacity()}"
    say f"Oldest item (peek): {rb.peek()}"
    say f"Newest item (peek_last): {rb.peek_last()}"
    say "Buffer items in FIFO order:"
    let rb_items = rb.to_array()
    for item in rb_items
        say f"  - {item}"
    end

    # Overwrite on capacity
    rb.push("delta")
    rb.push_overwrite("epsilon")
    say f"Popped oldest after overwrite: {rb.pop()}"
    say ""

    # 2. DoublyLinkedList
    say "--- 2. DoublyLinkedList ---"
    let list = pkg::new_linked_list()
    list.push_back("Task B")
    list.push_front("Task A")
    list.push_back("Task C")
    say f"LinkedList size: {list.size()}"
    say f"Head: {list.peek_front()}"
    say f"Tail: {list.peek_back()}"
    say "List items from head to tail:"
    let list_items = list.to_array()
    for item in list_items
        say f"  - {item}"
    end
    list.remove("Task B")
    say f"Size after removing 'Task B': {list.size()}"
    say ""

    # 3. Trie (Prefix Tree)
    say "--- 3. Trie (Prefix Tree) ---"
    let tr = pkg::new_trie()
    tr.insert("apple", 10)
    tr.insert("app", 20)
    tr.insert("application", 30)
    tr.insert("banana", 40)
    let has_app = tr.contains("app")
    let has_orange = tr.contains("orange")
    let starts_app = tr.starts_with("app")
    say f"Trie distinct keys: {tr.size()}"
    say f"Contains 'app': {has_app}"
    say f"Contains 'orange': {has_orange}"
    say f"Starts with 'app': {starts_app}"
    say "Keys matching prefix 'app':"
    say tr.keys_with_prefix("app")
    say ""

    # 4. BitSet
    say "--- 4. BitSet ---"
    let bs = pkg::new_bit_set(64)
    bs.set(0)
    bs.set(10)
    bs.set(20)
    let bit10 = bs.get(10)
    let bit11 = bs.get(11)
    say f"BitSet capacity: {bs.capacity()}"
    say f"Set bits count: {bs.count_ones()}"
    say f"Bit 10 is set: {bit10}"
    say f"Bit 11 is set: {bit11}"
    say "Active bit indices:"
    let bs_bits = bs.to_array()
    for b in bs_bits
        say f"  - bit {b}"
    end
    say ""

    # 5. BloomFilter
    say "--- 5. BloomFilter ---"
    let bf = pkg::new_bloom_filter(100, 0.01)
    bf.add("email_alice@example.com")
    bf.add("email_bob@example.com")
    let has_alice = bf.contains("email_alice@example.com")
    let has_bob = bf.contains("email_bob@example.com")
    let has_charlie = bf.contains("email_charlie@example.com")
    say f"BloomFilter items added: {bf.count()}"
    say f"Contains alice: {has_alice}"
    say f"Contains bob: {has_bob}"
    say f"Contains charlie: {has_charlie}"
    say ""

    say "=== All datatypes demonstrations completed! ==="
end

main()
