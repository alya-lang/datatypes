## datatypes Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Exposes high-performance advanced data structures: RingBuffer, DoublyLinkedList,
## Trie, BitSet, and BloomFilter.

import "./types.alya"
import "./ring_buffer.alya"
import "./linked_list.alya"
import "./trie.alya"
import "./bit_set.alya"
import "./bloom_filter.alya"

# ───────────────────────────────────────────────────────────────
# Primary Factory APIs
# ───────────────────────────────────────────────────────────────

## Constructs a new fixed-capacity circular RingBuffer.
##
## ### Parameters
## - `capacity`: Maximum number of slots in the circular buffer. Defaults to 16.
##
## ### Returns
## An empty `RingBuffer` instance.
##
## ### Examples
## ```alya
## let rb = new_ring_buffer(8)
## rb.push(42)
## ```
pub function new_ring_buffer(capacity: int = 16) -> RingBuffer
    return make_ring_buffer(capacity)
end

## Constructs a new empty DoublyLinkedList.
##
## ### Returns
## An empty `DoublyLinkedList` instance with O(1) front/back operations.
##
## ### Examples
## ```alya
## let list = new_linked_list()
## list.push_back("world")
## list.push_front("hello")
## ```
pub function new_linked_list() -> DoublyLinkedList
    return make_linked_list()
end

## Constructs a new empty Trie prefix tree for fast string search and autocompletion.
##
## ### Returns
## An empty `Trie` instance.
##
## ### Examples
## ```alya
## let tr = new_trie()
## tr.insert("alya", 1)
## say tr.starts_with("al") # true
## ```
pub function new_trie() -> Trie
    return make_trie()
end

## Constructs a new BitSet with capacity for at least `num_bits` bits.
##
## ### Parameters
## - `num_bits`: Number of bits to allocate. Defaults to 64.
##
## ### Returns
## A `BitSet` instance with all bits initialized to 0.
##
## ### Examples
## ```alya
## let bs = new_bit_set(128)
## bs.set(5)
## say bs.get(5) # true
## ```
pub function new_bit_set(num_bits: int = 64) -> BitSet
    return make_bit_set(num_bits)
end

## Constructs a new BloomFilter with given expected capacity and false positive probability.
##
## ### Parameters
## - `expected_items`: Estimated element count. Defaults to 1000.
## - `false_positive_rate`: Target false positive probability (e.g. 0.01 for 1%). Defaults to 0.01.
##
## ### Returns
## An empty `BloomFilter` instance.
##
## ### Examples
## ```alya
## let bf = new_bloom_filter(500, 0.01)
## bf.add("user_123")
## say bf.contains("user_123") # true
## say bf.contains("unknown")  # false
## ```
pub function new_bloom_filter(expected_items: int = 1000, false_positive_rate: float = 0.01) -> BloomFilter
    return make_bloom_filter(expected_items, false_positive_rate)
end
