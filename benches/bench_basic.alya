## Benchmark suite for datatypes
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    let runner = bench_runner("datatypes Micro-Benchmarks")

    # Bench 1: RingBuffer push + pop throughput — 50k iterations
    let rb = pkg::new_ring_buffer(32)
    bench_start(runner, 50000)
    let i = 0
    while i < 50000
        rb.push(i)
        if rb.is_full()
            rb.pop()
        end
        i += 1
    end
    bench_stop(runner, "RingBuffer push/pop 50k ops")

    # Bench 2: DoublyLinkedList push_back + pop_front — 50k iterations
    let list = pkg::new_linked_list()
    bench_start(runner, 50000)
    let j = 0
    while j < 50000
        list.push_back(j)
        if list.size() > 16
            list.pop_front()
        end
        j += 1
    end
    bench_stop(runner, "DoublyLinkedList push/pop 50k ops")

    # Bench 3: Trie insert & contains — 10k iterations
    let tr = pkg::new_trie()
    bench_start(runner, 10000)
    let k = 0
    while k < 10000
        tr.insert("key_" + str(k % 100), k)
        tr.contains("key_" + str(k % 100))
        k += 1
    end
    bench_stop(runner, "Trie insert + lookup 10k ops")

    # Bench 4: BitSet set & get — 100k iterations
    let bs = pkg::new_bit_set(256)
    bench_start(runner, 100000)
    let b = 0
    while b < 100000
        let bit = b % 256
        bs.set(bit)
        bs.get(bit)
        b += 1
    end
    bench_stop(runner, "BitSet set/get 100k ops")

    # Bench 5: BloomFilter add & contains — 20k iterations
    let bf = pkg::new_bloom_filter(1000, 0.01)
    bench_start(runner, 20000)
    let m = 0
    while m < 20000
        bf.add("item_" + str(m % 500))
        bf.contains("item_" + str(m % 500))
        m += 1
    end
    bench_stop(runner, "BloomFilter add/check 20k ops")

    bench_summary(runner)
end

main()
