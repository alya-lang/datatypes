## Test suite for datatypes
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

@cfg(feature = "ring_buffer")
function test_ring_buffer(r)
    # 1. RingBuffer Tests
    # ═══════════════════════════════════════════════════════════
    let rb = pkg::new_ring_buffer(3)
    runner_assert_true(r, rb.is_empty(), "ring buffer starts empty")
    runner_assert_false(r, rb.is_full(), "ring buffer starts not full")
    runner_assert_eq(r, rb.size(), 0, "ring buffer initial size is 0")
    runner_assert_eq(r, rb.capacity(), 3, "ring buffer capacity is 3")

    runner_assert_true(r, rb.push(10), "rb.push(10) succeeds")
    runner_assert_true(r, rb.push(20), "rb.push(20) succeeds")
    runner_assert_eq(r, rb.size(), 2, "rb size is 2 after two pushes")
    runner_assert_eq(r, rb.peek(), 10, "rb peek is oldest element 10")
    runner_assert_eq(r, rb.peek_last(), 20, "rb peek_last is newest element 20")

    runner_assert_true(r, rb.push(30), "rb.push(30) succeeds, filling buffer")
    runner_assert_true(r, rb.is_full(), "rb is full at capacity 3")
    runner_assert_false(r, rb.push(40), "rb.push(40) fails when buffer is full")

    # Overwrite push
    runner_assert_true(r, rb.push_overwrite(40), "rb.push_overwrite(40) succeeds")
    runner_assert_eq(r, rb.peek(), 20, "rb peek advances to 20 after overwrite")
    runner_assert_eq(r, rb.peek_last(), 40, "rb peek_last is 40")

    # Pop order
    runner_assert_eq(r, rb.pop(), 20, "rb.pop() yields 20")
    runner_assert_eq(r, rb.pop(), 30, "rb.pop() yields 30")
    runner_assert_eq(r, rb.pop(), 40, "rb.pop() yields 40")
    runner_assert_true(r, rb.is_empty(), "rb is empty after popping all")

    # to_array
    rb.push(1)
    rb.push(2)
    let rb_arr = rb.to_array()
    runner_assert_eq(r, len(rb_arr), 2, "rb.to_array() length matches")
    runner_assert_eq(r, rb_arr[0], 1, "rb.to_array()[0] is 1")
    runner_assert_eq(r, rb_arr[1], 2, "rb.to_array()[1] is 2")

    rb.clear()
    runner_assert_true(r, rb.is_empty(), "rb.clear() resets buffer")

    # ═══════════════════════════════════════════════════════════
end

@cfg(not(feature = "ring_buffer"))
function test_ring_buffer(r)
end

@cfg(feature = "linked_list")
function test_linked_list(r)
    # 2. DoublyLinkedList Tests
    # ═══════════════════════════════════════════════════════════
    let list = pkg::new_linked_list()
    runner_assert_true(r, list.is_empty(), "linked list starts empty")
    runner_assert_eq(r, list.size(), 0, "linked list size starts at 0")

    list.push_back(100)
    list.push_back(200)
    list.push_front(50)
    runner_assert_eq(r, list.size(), 3, "list size is 3 after 3 pushes")
    runner_assert_eq(r, list.peek_front(), 50, "peek_front is 50")
    runner_assert_eq(r, list.peek_back(), 200, "peek_back is 200")
    runner_assert_true(r, list.contains(100), "list contains 100")
    runner_assert_false(r, list.contains(999), "list does not contain 999")

    # Array conversion
    let l_arr = list.to_array()
    runner_assert_eq(r, len(l_arr), 3, "list.to_array() length is 3")
    runner_assert_eq(r, l_arr[0], 50, "first element is 50")
    runner_assert_eq(r, l_arr[1], 100, "second element is 100")
    runner_assert_eq(r, l_arr[2], 200, "third element is 200")

    # Removal
    runner_assert_true(r, list.remove(100), "list.remove(100) succeeds")
    runner_assert_eq(r, list.size(), 2, "list size decreases to 2")
    runner_assert_false(r, list.contains(100), "list no longer contains 100")

    # Pops
    runner_assert_eq(r, list.pop_front(), 50, "pop_front yields 50")
    runner_assert_eq(r, list.pop_back(), 200, "pop_back yields 200")
    runner_assert_true(r, list.is_empty(), "list is empty after pops")

    list.push_back(1)
    list.clear()
    runner_assert_true(r, list.is_empty(), "list.clear() empties list")

    # ═══════════════════════════════════════════════════════════
end

@cfg(not(feature = "linked_list"))
function test_linked_list(r)
end

@cfg(feature = "trie")
function test_trie(r)
    # 3. Trie Tests
    # ═══════════════════════════════════════════════════════════
    let tr = pkg::new_trie()
    runner_assert_eq(r, tr.size(), 0, "trie starts with size 0")

    tr.insert("apple", 1)
    tr.insert("app", 2)
    tr.insert("application", 3)
    tr.insert("banana", 4)
    runner_assert_eq(r, tr.size(), 4, "trie size is 4")

    runner_assert_true(r, tr.contains("apple"), "trie contains 'apple'")
    runner_assert_true(r, tr.contains("app"), "trie contains 'app'")
    runner_assert_false(r, tr.contains("ap"), "trie does not contain 'ap'")
    runner_assert_true(r, tr.starts_with("ap"), "trie starts_with 'ap'")
    runner_assert_false(r, tr.starts_with("cat"), "trie does not start with 'cat'")

    runner_assert_eq(r, tr.get("app"), 2, "tr.get('app') returns 2")
    runner_assert_eq(r, tr.get("banana"), 4, "tr.get('banana') returns 4")

    let app_keys = tr.keys_with_prefix("app")
    runner_assert_eq(r, len(app_keys), 3, "prefix 'app' matches 3 keys")

    runner_assert_true(r, tr.remove("apple"), "tr.remove('apple') succeeds")
    runner_assert_eq(r, tr.size(), 3, "trie size decreases to 3")
    runner_assert_false(r, tr.contains("apple"), "trie no longer contains 'apple'")
    runner_assert_true(r, tr.contains("app"), "trie still contains 'app'")

    tr.clear()
    runner_assert_eq(r, tr.size(), 0, "tr.clear() resets size to 0")

    # ═══════════════════════════════════════════════════════════
end

@cfg(not(feature = "trie"))
function test_trie(r)
end

@cfg(feature = "bit_set")
function test_bit_set(r)
    # 4. BitSet Tests
    # ═══════════════════════════════════════════════════════════
    let bs = pkg::new_bit_set(128)
    runner_assert_eq(r, bs.capacity(), 128, "bitset capacity is 128")
    runner_assert_eq(r, bs.count_ones(), 0, "bitset starts with zero 1s")

    runner_assert_true(r, bs.set(0), "bs.set(0) succeeds")
    runner_assert_true(r, bs.set(5), "bs.set(5) succeeds")
    runner_assert_true(r, bs.set(70), "bs.set(70) across word boundary succeeds")
    runner_assert_eq(r, bs.count_ones(), 3, "count_ones is 3")

    runner_assert_true(r, bs.get(0), "bs.get(0) is true")
    runner_assert_true(r, bs.get(5), "bs.get(5) is true")
    runner_assert_true(r, bs.get(70), "bs.get(70) is true")
    runner_assert_false(r, bs.get(1), "bs.get(1) is false")

    runner_assert_true(r, bs.clear_bit(5), "bs.clear_bit(5) succeeds")
    runner_assert_false(r, bs.get(5), "bs.get(5) is false after clear")
    runner_assert_eq(r, bs.count_ones(), 2, "count_ones is 2 after clearing 5")

    runner_assert_true(r, bs.toggle(0), "bs.toggle(0) flips to 0")
    runner_assert_false(r, bs.get(0), "bs.get(0) is false")
    runner_assert_true(r, bs.toggle(0), "bs.toggle(0) flips back to 1")
    runner_assert_true(r, bs.get(0), "bs.get(0) is true")

    # Set operations
    let b1 = pkg::new_bit_set(64)
    b1.set(1)
    b1.set(2)
    let b2 = pkg::new_bit_set(64)
    b2.set(2)
    b2.set(3)

    let b_union = b1.union(b2)
    runner_assert_eq(r, b_union.count_ones(), 3, "union has 3 bits (1, 2, 3)")
    runner_assert_true(r, b_union.get(1), "union has 1")
    runner_assert_true(r, b_union.get(2), "union has 2")
    runner_assert_true(r, b_union.get(3), "union has 3")

    let b_inter = b1.intersection(b2)
    runner_assert_eq(r, b_inter.count_ones(), 1, "intersection has 1 bit (2)")
    runner_assert_true(r, b_inter.get(2), "intersection has 2")

    let b_arr = b1.to_array()
    runner_assert_eq(r, len(b_arr), 2, "b1.to_array() has 2 elements")
    runner_assert_eq(r, b_arr[0], 1, "b1 bit 0 is 1")
    runner_assert_eq(r, b_arr[1], 2, "b1 bit 1 is 2")

    # ═══════════════════════════════════════════════════════════
end

@cfg(not(feature = "bit_set"))
function test_bit_set(r)
end

@cfg(feature = "bloom_filter")
function test_bloom_filter(r)
    # 5. BloomFilter Tests
    # ═══════════════════════════════════════════════════════════
    let bf = pkg::new_bloom_filter(100, 0.01)
    runner_assert_eq(r, bf.count(), 0, "bloom filter starts empty")

    bf.add("user_alice")
    bf.add("user_bob")
    bf.add("user_charlie")
    runner_assert_eq(r, bf.count(), 3, "bloom filter count is 3")

    runner_assert_true(r, bf.contains("user_alice"), "bf contains 'user_alice'")
    runner_assert_true(r, bf.contains("user_bob"), "bf contains 'user_bob'")
    runner_assert_true(r, bf.contains("user_charlie"), "bf contains 'user_charlie'")
    runner_assert_false(r, bf.contains("non_existent_key_999xyz"), "bf does not contain missing key")

    bf.clear()
    runner_assert_eq(r, bf.count(), 0, "bf.clear() resets count")
    runner_assert_false(r, bf.contains("user_alice"), "bf does not contain alice after clear")

end

@cfg(not(feature = "bloom_filter"))
function test_bloom_filter(r)
end

function main()
    test_suite("datatypes Test Suite")
    let r = runner_new()

    test_ring_buffer(r)
    test_linked_list(r)
    test_trie(r)
    test_bit_set(r)
    test_bloom_filter(r)

    let failed = runner_summary(r)
    if failed > 0
        say f"Test failure: {failed} test(s) failed."
    end
end

main()
